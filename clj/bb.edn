;; Scoped bb.edn for the kotoba-erp clj port (ADR-2606280030).
;; Self-contained: the port uses an in-repo StateGraph shim (kotoba-erp.graph)
;; and clojure.test only, so no langgraph-clj / langchain-clj dep is required.
;; Does NOT touch the repo-root bb.edn.
{:paths ["src" "test"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ba75f68e357109686ade80025438051df7eb21ad"
         :deps/root "lib/kotoba.text"}}
 :tasks
 {test {:doc "Run the kotoba-erp clojure.test suite under babashka."
        :extra-paths ["test"]
        :task (load-file "run_tests.clj")}}}
